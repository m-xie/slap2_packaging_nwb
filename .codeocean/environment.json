{
	"version": 1,
	"base_image": "codeocean/jupyterlab:3.6.1-miniconda4.12.0-python3.9-ubuntu20.04",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "argparse"
				},
				{
					"name": "git+https://github.com/AllenInstitute/openscope_upload.git#egg=openscope-upload",
					"version": "d54ae99620cb81f92cffa75ecf2fe66e9ee2e3b2"
				},
				{
					"name": "h5py",
					"version": "3.14.0"
				},
				{
					"name": "harp-python",
					"version": "0.4.1"
				},
				{
					"name": "hdmf-zarr",
					"version": "0.11.2"
				},
				{
					"name": "matplotlib"
				},
				{
					"name": "pynwb",
					"version": "3.1.1"
				}
			],
			"options": {},
			"pre_install_options": {}
		},
		"vscode": {
			"packages": [
				{
					"name": "continue.continue"
				},
				{
					"name": "ms-python.python"
				},
				{
					"name": "ms-toolsai.jupyter"
				},
				{
					"name": "reageyao.biosyntax"
				},
				{
					"name": "reditorsupport.r"
				},
				{
					"name": "saoudrizwan.claude-dev"
				}
			],
			"version": "4.100.3"
		}
	}
}